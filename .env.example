# Justice Vault Environment Configuration
# Lenovo LEAP AI Hackathon 2026 - Theme 2: Digital Inclusion & Public Access

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
APP_MODE=demo  # 'demo' (deterministic local verified engine) or 'production'

# OpenAI API Key (Optional. If not provided, Justice Vault uses the verified local deterministic engine)
OPENAI_API_KEY=

# Security & Storage
JWT_SECRET=justice_vault_hackathon_jwt_secret_2026_super_secure_key
STORAGE_ENCRYPTION_KEY=justice_vault_aes256_mock_key_32_bytes_lenovo
DATABASE_URL=sqlite:///./justice_vault.db

# Storage Directories
DATA_DIR=backend/knowledge
UPLOAD_DIR=backend/uploads
